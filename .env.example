# === HR Recruitment Toolkit — self-hosted PostgreSQL + Kurma Mail ===

# --- Database ---
# Postgres host yang sama dipakai email-company (user 'kurma', password
# sama seperti di email-company/.env). Database 'hr_tools' harus dibuat
# dulu secara manual: CREATE DATABASE hr_tools; (lihat README untuk langkah lengkap)
DATABASE_URL=postgresql://kurma:password_sama_dengan_email_company@host.docker.internal:5432/hr_tools

# --- Session (cookie auth sendiri, bukan Supabase) ---
# Minimal 32 karakter acak. JANGAN sama dengan SESSION_SECRET milik email-company
# (kalau sama, cookie dari satu app bisa diverifikasi app lain secara tidak sengaja).
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# --- URL aplikasi ini sendiri (dipakai di link email notifikasi) ---
# Lokal: http://localhost:3100, prod: https://hr.kurmagroup.biz.id (atau domain Anda)
APP_URL=http://localhost:3100
# URL PUBLIK yang ditempel ke link undangan kandidat (/invite/...) — WAJIB diisi
# dengan domain/IP yang bisa dibuka kandidat dari device lain. Kalau masih
# localhost, link undangan tidak bisa dibuka dari HP kandidat.
# Contoh prod: https://hr.kurmagroup.biz.id
# (Di-bake ke bundle client saat docker build, jadi setelah mengubah harus rebuild.)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Akun HR pertama (dibuat otomatis saat database diinisialisasi) ---
DEFAULT_USER_NAME="HR Admin"
DEFAULT_USER_EMAIL=hr@kurmagroup.biz.id
DEFAULT_USER_PASSWORD=password_admin_aman_anda

# --- Akun Dev/Admin (role 'dev', akses penuh termasuk /hr/users) ---
# Dibuat idempotent by-email: aman dijalankan ulang, tidak akan dibuat dobel.
DEV_USER_NAME="Developer"
DEV_USER_EMAIL=dev@kurmagroup.biz.id
DEV_USER_PASSWORD=password_dev_aman_anda

# --- Notifikasi email ---
# Email tujuan notifikasi HR saat kandidat submit Tes DISC/IQ.
HR_NOTIFY_EMAIL=hr@kurmagroup.biz.id

# Kurma Mail (email-company) — dipanggil via Docker network internal, BUKAN
# domain publik, karena hr-tools join network email-custom_default yang sama.
# Default sudah benar untuk setup ini; ubah hanya jika nama service Kurma Mail
# berbeda atau dijalankan di host lain.
EMAIL_SERVICE_URL=http://email_web:3000
# Harus SAMA dengan EMAIL_SERVICE_API_KEY di email-company/.env
EMAIL_SERVICE_API_KEY=string_acak_sama_dengan_email_company
